{
  "model": "courses.course",
  "pk": 20,
  "fields": {
    "title": "English A1: Start Your Journey",
    "description": "Курс предназначен для пользователей, которые только начинают изучать английский язык. В рамках курса обучающийся знакомится с базовой лексикой, простыми фразами для знакомства, глаголом to be, личными местоимениями и простыми предложениями. Курс помогает сформировать начальную языковую базу для дальнейшего изучения английского языка.",
    "level": "A1",
    "category": "general",
    "is_public": true,
    "image": "",
    "created_at": "2026-05-26T03:27:39.422Z"
  }
},
{
  "model": "courses.course",
  "pk": 21,
  "fields": {
    "title": "Advanced English for IT",
    "description": "Курс предназначен для пользователей, которые хотят изучать профессиональный английский язык в сфере информационных технологий. В курсе рассматриваются термины, связанные с разработкой программного обеспечения, базами данных, командной работой, Git, документацией и описанием технических задач.",
    "level": "C1",
    "category": "it",
    "is_public": false,
    "image": "",
    "created_at": "2026-05-26T03:42:37.983Z"
  }
},
